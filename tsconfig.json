{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    
    /* Outras saídas */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Regras de checagem */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* Desativado para permitir migração sem travar imports */
    "verbatimModuleSyntax": false
  }
}